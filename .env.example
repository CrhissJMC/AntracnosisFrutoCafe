# Copia este archivo como .env y cambia los valores.
# Usa solo letras y números en POSTGRES_PASSWORD (va dentro de una URL).

# Base de datos
POSTGRES_DB=antracnosis
POSTGRES_USER=antracnosis
POSTGRES_PASSWORD=cambia_esta_clave

# Secreto para firmar las sesiones (mínimo 32 caracteres, aleatorio)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria-de-32-o-mas

# Administrador inicial (se crea la primera vez que arranca la API)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@antracnosis.pe
ADMIN_PASSWORD=cambia_esta_clave_admin

# Puertos en tu PC
WEB_PORT=8080
DB_PORT=5433

# Pon true solo si publicas el sitio con HTTPS
COOKIE_SECURE=false

# 2 cuando uses el túnel de Cloudflare (nginx + túnel)
TRUST_PROXY_HOPS=1
